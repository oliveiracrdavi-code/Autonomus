# Copie para .env (que não vai para o git) ou exporte no terminal antes de npm start.
# Uma ou mais chaves da NVIDIA, separadas por vírgula. Elas são tentadas em ordem se uma falhar.
NVIDIA_API_KEYS=nvapi-SUBSTITUA-PELA-SUA-CHAVE
# Porta e endereço (127.0.0.1 mantém o servidor acessível só nesta máquina)
PORT=8080
HOST=127.0.0.1
